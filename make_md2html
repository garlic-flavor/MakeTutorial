## ### Shell Script を処理する。
#==============================================================================
function processSh {
  local key1=(function if then elif else fi local while do done for in \
    case esac typeset setopt unsetopt return break)
  local key2=(echo print printf exit)
  while feedBuffer; do
    processOutput || \
    processOneLineComment || \
    processSingleQuoteOfSh || \
    processDoubleQuoteOfSh || \
    processVariableReferenceOfSh || \
    processSimpleEscapeSequence || \
    processKeywords ${(j<|>)key1} || \
    processKeywords ${(j<|>)key2} 'keyword2' || \
    processWord || \
    processChar
  done
}

## ### 文字列を開始する。
## Params:
## - $1 : クォート文字列。初期値は"'"。
## - $2 : 文字列を括るspan要素のクラス属性を指定する。初期値は"string"。
#------------------------------------------------------------------------------
function processSingleQuoteOfSh {
  local q=${1:-"'"} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || \
    processChar
  done
}

## ### 文字列を開始する。
## Params:
## - $1 : クォート文字列。初期値は"&quot;"。
## - $2 : 文字列を括るspan要素のクラス属性を指定する。初期値は"string"。
#------------------------------------------------------------------------------
function processDoubleQuoteOfSh {
  local q=${1:-"&quot;"} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || \
    processVariableReferenceOfSh || \
    processChar
  done
}
## ### $変数参照を処理する。
## zshの変数の参照の様なものを処理する。
## Params:
## - $1 : 処理結果が格納されるspan要素のclass属性。初期値は"variable"。
#------------------------------------------------------------------------------
function processVariableReferenceOfSh {
  local class=${1:-variable}

  # &" は変数ではない。
  if [[ $buf = \$\&quot\;* ]]; then return 1; fi
  if ! processStartSpanIf '$' $class; then return 1; fi

  processBalancedBracketOfSh || \
  processEntity || \
  processWord || \
  processChar
  print -rn - "</span>"
}

## ### 対応する括弧を処理する。
#------------------------------------------------------------------------------
function processBalancedBracketOfSh {
  processBalancedOfSh || \
  processBalancedOfSh '(' ')' || \
  processBalancedOfSh '[' ']'
  return $?
}

## ### 変数参照内部のトークンを処理する。
#------------------------------------------------------------------------------
function processShTokenInVariableReference {
  processVariableReferenceOfSh || \
  processSingleQuoteOfSh || \
  processDoubleQuoteOfSh || \
  processSimpleEscapeSequence || \
  processWord || \
  processChar
  return $?
}

## ### 対応する括弧を処理する。
## Params:
## - $1 : 開き括弧。初期値は'{'
## - $2 : 閉じ括弧。初期値は'}'
#------------------------------------------------------------------------------
function processBalancedOfSh {
  local open=${1:-\{} close=${2:-\}}
  if ! processIf $open; then return 1; fi
  while feedBuffer; do
    if processIf $close; then
      break;
    else
      processBalancedBracketOfSh || \
      processShTokenInVariableReference
    fi
  done
}

## ### Tcl を処理する。
#==============================================================================
function processTcl {
  local key1=(proc if then elseif else for set switch default while upvar \
    global package namespace eval provide export ensemble foreach)
  local key2=(puts return incr array require expr dict wm grid)
  while feedBuffer; do
    processOutput || \
    processOneLineComment || \
    processVariableReferenceOfTcl || \
    processDoubleQuoteOfTcl || \
    processKeywords ${(j<|>)key1} || \
    processKeywords ${(j<|>)key2} 'keyword2' || \
    processWord || \
    processChar
  done
}

#------------------------------------------------------------------------------
function processDoubleQuoteOfTcl {
  local q=${1:-"&quot;"} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || \
    processVariableReferenceOfTcl || \
    processBalancedOfTcl '[' ']' "</span>" "<span class=\"$class\">" || \
    processChar
  done
}

#------------------------------------------------------------------------------
function processBalancedOfTcl {
  local open=${1:-\{} close=${2:-\}}
  if ! processIf $open $3; then return 1; fi
  while feedBuffer; do
    if processIf $close; then
      break
    else
      processBalancedOfTcl $open $close || \
      processTclToken
    fi
  done
  print -rn $4
}
#------------------------------------------------------------------------------
function processVariableReferenceOfTcl {
  local class=${1:-variable}
  if ! processStartSpanIf '$' $class; then return 1; fi
  processWord || \
  processChar
  print -rn - "</span>"
}

