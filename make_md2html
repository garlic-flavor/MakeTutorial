## ## code要素を処理する。
## - それぞれの言語に処理を分配する。
#------------------------------------------------------------------------------
function processCode {
  feedBuffer -n
  # Tcl
  if   [[ $1 == tcl ]]; then
    processTcl
  # C/C++
  elif [[ $1 == c || $1 == cpp ]]; then
    processC
  # Fortran
  elif [[ $1 == fortran ]]; then
    processFortran
  # AppleScript
  elif [[ $1 == applescript ]]; then
    processAppleScript
  # Lua
  elif [[ $1 == lua ]]; then
    processLua
  # TypeScript
  elif [[ $1 == ts ]]; then
    processTypeScript
  # JSON
  elif [[ $1 == json ]]; then
    processJSON
  # SQL
  elif [[ $1 == sql ]]; then
    processSQL
  # Java
  elif [[ $1 == java ]]; then
    processJava
  # Sh
  else
    processSh
  fi
}

## ## HTML Body
## cmark-gfmの出力がここに来る。
#------------------------------------------------------------------------------
function processBody {
  local language rest pre tag
  local -a code

  while IFS= read -r rest; do
    while [[ -n $rest ]]; do
      # タグとそれ以外に分離する。
      if [[ ! $rest =~ "^([^<]*)(<[^>]+>)?(.*)" ]]; then continue; fi
      pre=$match[1]; tag=$match[2]; rest=$match[3]

      # code要素が来たら
      if [[ $tag =~ "^<code[[:space:]]+class[[:space:]]*=[[:space:]]*\"language-([^\"]*)\"[[:space:]]*>$" ]]; then
        language=${match[1]:-sh}
        print -rn - "<div class=\"language-type\">$language</div>";
        print -rn - $pre$tag
        code=($rest)
        while IFS= read -r rest; do
          if [[ ! $rest =~ "^([^<]*)(<[^>]+>)?(.*)" ]]; then continue; fi
          pre=$match[1]; tag=$match[2]; rest=$match[3]
          code+=$pre
          # /codeタグが来たらlanguageを終わる。
          if [[ $tag =~ "^</code[[:space:]]*>$" ]]; then
            print -lr - $code | processCode $language
            print -rn - $tag
            break;
          fi
        done
      else
        print -rn - $pre$tag
      fi
    done
    print -
  done
}

