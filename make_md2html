## ## 各言語で共用する部分
typeset -g buf # グローバル変数で使いまわしてるので注意
               # 未処理の一行を格納する。

## ### バッファが空なら埋める。
## もしバッファが空なら、改行を出力し、バッファに読み込む。
##
## Params:
## - -n: 改行を挿入しない。
##
## Return:
## - 読み込めるものがなければ1を返す。
#------------------------------------------------------------------------------
function feedBuffer {
  local opt nonewline
  while getopts n opt; do
    case $opt in
      n) nonewline=true ;;
      *) :;;
    esac
  done
  (( 1 < OPTIND )) && shift $((OPTIND - 1))

  if [[ -z $buf ]] then
    if [[ ! $nonewline ]]; then
      print -
    fi
    if ! IFS= read -r buf; then
      return 1
    fi
  fi
}

## ### とりあえず一文字処理する。
## Params:
## - $1 : 処理する文字数を指定する。
#------------------------------------------------------------------------------
function processChar {
  local n=${1:-1}
  #         ┗第一引数が無ければ1を代入
  print -rn - ${buf:0:$n}
  #         ┗ printのオプションをここまでとする。'-'一文字を出力する際に必要。
  buf=${buf:$n}
  #        ┗ $n 文字目より後のスライスを代入
}

## ### もし先頭が$1なら処理する。
## Params:
## - $1 : テストする文字列
## - $2 : もし真だったら先にこれも出力する。
## - $3 : もし真だったら後にこれも出力する。
##
## Return:
## - $1で始まっていなけれは1を返す。
#------------------------------------------------------------------------------
function processIf {
  if [[ $buf != $1* ]]; then return 1; fi
  #               ┗後ろに任意の文字が続いていても良い
  print -rn - $2
  processChar ${#1}
  print -rn - $3
}

## ### <span>要素を開始する。
## Params:
## - $1 : テストする文字列
##
## Return:
## - $1で始まっていなければ1を返す。
#------------------------------------------------------------------------------
function processStartSpanIf {
  processIf $1 "<span class=\"$2\">"
  return $?
}

## ### </span>
## Params:
## - $1 : テストする文字列。
#------------------------------------------------------------------------------
function processEndSpanIf {
  processIf $1 '' '</span>'
  return $?
}
## ### 正規表現にマッチしたら処理する。
## Params:
## - $1 : テストする正規表現
## - $2 : もしマッチしていたらマッチした文字列の前に出力する。
## - $3 : もしマッチしていたらマッチした文字列の後に出力する。
#------------------------------------------------------------------------------
function processMatch {
  if [[ ! $buf =~ $1 ]]; then return 1; fi
  #             ┗正規表現でテストする。
  print -rn - $2
  processChar ${#MATCH}
  #               ┗マッチの結果が格納されている。
  print -rn - $3
}

## ### 文字実体参照を処理する。
## Return:
## - 文字実体参照でなければ1を返す。
#------------------------------------------------------------------------------
function processEntity {
  processMatch "^&(amp|quot|lt|gt);"
  return $?
}

## ### 一行コメントを処理する。
## Params:
## - $1 : 一行コメントを開始するパターン。初期値は'#'
## - $2 : コメントはspan要素で出力される。その際のclassを指定する。
##        初期値は`comment`
##
## Return:
## - コメント行でなければ1を返す。
#------------------------------------------------------------------------------
function processOneLineComment {
  local header=${1:-'#'} class=${2:-comment}
  if ! processIf $header "<span class=\"$class\">"; then return 1; fi
  print -rn - $buf"</span>"
  buf=
}

## ### 最も単純なエスケープシーケンスを処理する。
## Return:
## - バックスラッシュでなければ1を返す。
#------------------------------------------------------------------------------
function processSimpleEscapeSequence {
  if ! processIf "\\"; then return 1; fi
  processChar
}

## ### シンプルな文字列を処理する。
## Params:
## - $1 : クォート文字。ダブルクォートは文字実体参照により`&quot;`になっている
##        ので注意。
## - $2 : span要素のclass属性を指定する。
##        初期値は`string`。
## Return:
## - クォートで始まっていなければ1を返す。
#------------------------------------------------------------------------------
function processSimpleQuote {
  local q=${1:-'&quot;'} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || processChar
  done
}

## ### 一単語処理する。
## Params:
## - $1 : 単語を構成する一文字にマッチする正規表現。
##        初期値は`[a-zA-Z0-9_]`
##
## Return:
## - 先頭文字が$1に含まれなければ1を返す。
#------------------------------------------------------------------------------
function processWord {
  local r=${1:-'[a-zA-Z0-9_]'}
  processMatch "^$r+"
  return $?
}

## ### キーワードを処理する。
## Params:
## - $1 : キーワードを"|"で繋いだ文字列。
## - $2 : キーワードを括るspan要素のclass属性。初期値は"keyword"。
##
## Return:
## - キーワードでなければ1を返す。
#------------------------------------------------------------------------------
function processKeywords {
  local keys=$1 class=${2:-keyword}
  processMatch "^($keys)[[:>:]]" "<span class=\"$class\">" "</span>"
  return $?
}

## ### シンプルな数値を処理する。
## Params:
## - $1 : 数値だった場合のクラス名
##
## Return:
## - 数値でなければ1を返す。
#------------------------------------------------------------------------------
function processSimpleNumber {
  local class=${1:-number}
  if ! processMatch '^[-+.]?[0-9]' "<span class=\"$class\">"; then
    return 1;
  fi
  processMatch '^[-+.xXpP0-9a-fA-F]+'
  print -rn - '</span>'
}

## ### 出力行を処理する。
## 行頭は1行コメントなので先にこちらを処理しないとヒットしない。
## Params:
## - $1 : 出力行の開始パターンを指定する。初期値は"#>"
## - $2 : 出力行が括られるspan要素のclass属性。初期値は"output"。
##
## Return:
## - 出力行でなければ1を返す。
#------------------------------------------------------------------------------
function processOutput {
  local header=${1:-'#&gt;'} class=${2:-output}
  if [[ $buf != $header* ]]; then return 1; fi
  print -rn - "<span class=\"$class\">"
  buf=${buf:${#header}}
  while [[ -n $buf ]]; do
    processSimpleNumber || \
    processChar
  done
  print -rn - '</span>'
}

## ## 個別の言語の処理
#//////////////////////////////////////////////////////////////////////////hide

## ### Shell Script を処理する。
## - [zsh reserved words](https://roel.rs/cgi-bin/info2www?(zsh)Reserved+Words)
#==============================================================================
function processSh {
  local key1=(do done esac then elif else fi for case if while function \
    repeat time until select coproc nocorrect foreach end declare export \
    float integer local readonly typeset then in setopt unsetopt return break)
  local key2=(echo print printf exit)
  while feedBuffer; do
    processOutput || \
    processOneLineComment || \
    processSingleQuoteOfSh || \
    processDoubleQuoteOfSh || \
    processVariableReferenceOfSh || \
    processSimpleEscapeSequence || \
    processKeywords ${(j<|>)key1} || \
    processKeywords ${(j<|>)key2} 'keyword2' || \
    processSimpleNumber || \
    processWord || \
    processChar
  done
}

## ### 文字列を開始する。
## Params:
## - $1 : クォート文字列。初期値は"'"。
## - $2 : 文字列を括るspan要素のクラス属性を指定する。初期値は"string"。
##
## Return:
## - クォートで始まらなければ1を返す。
#------------------------------------------------------------------------------
function processSingleQuoteOfSh {
  local q=${1:-"'"} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || \
    processChar
  done
}

## ### 文字列を開始する。
## 内部で変数参照を処理する。
## Params:
## - $1 : クォート文字列。初期値は"&quot;"。
## - $2 : 文字列を括るspan要素のクラス属性を指定する。初期値は"string"。
##
## Return:
## - クォートで始まらなければ1を返す。
#------------------------------------------------------------------------------
function processDoubleQuoteOfSh {
  local q=${1:-"&quot;"} class=${2:-string}
  if ! processStartSpanIf $q $class; then return 1; fi
  while feedBuffer; do
    if processEndSpanIf $q; then break; fi
    processSimpleEscapeSequence || \
    processVariableReferenceOfSh || \
    processChar
  done
}
## ### $変数参照を処理する。
## zshの変数の参照の様なものを処理する。
## Params:
## - $1 : 処理結果が格納されるspan要素のclass属性。初期値は"variable"。
##
## Return:
## - `$`で始まらなければ1を返す。
## - `$"`に対しても1を返す(正規表現の末尾を表す場合に現れる)。
#------------------------------------------------------------------------------
function processVariableReferenceOfSh {
  local class=${1:-variable}

  # $" は変数ではない。
  if [[ $buf = \$\&quot\;* ]]; then return 1; fi
  if ! processStartSpanIf '$' $class; then return 1; fi

  processBalancedBracketOfSh || \
  processEntity || \
  processWord || \
  processChar
  print -rn - "</span>"
}

## ### 対応する括弧を処理する。
## Return:
## - 括弧ではない場合に1を返す。
#------------------------------------------------------------------------------
function processBalancedBracketOfSh {
  processBalancedOfSh || \
  processBalancedOfSh '(' ')' || \
  processBalancedOfSh '[' ']'
  return $?
}

## ### 変数参照内部のトークンを処理する。
#------------------------------------------------------------------------------
function processShTokenInVariableReference {
  processVariableReferenceOfSh || \
  processSingleQuoteOfSh || \
  processDoubleQuoteOfSh || \
  processSimpleEscapeSequence || \
  processSimpleNumber || \
  processWord || \
  processChar
}

## ### 対応する括弧を処理する。
## Params:
## - $1 : 開き括弧。初期値は'{'
## - $2 : 閉じ括弧。初期値は'}'
##
## Return:
## - 開き括弧でない場合に1を返す。
#------------------------------------------------------------------------------
function processBalancedOfSh {
  local open=${1:-\{} close=${2:-\}}
  if ! processIf $open; then return 1; fi
  while feedBuffer; do
    if processIf $close; then
      break;
    else
      processBalancedBracketOfSh || \
      processShTokenInVariableReference
    fi
  done
}

